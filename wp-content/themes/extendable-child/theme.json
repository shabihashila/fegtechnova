{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "75rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "name": "Ink", "color": "#081A33" },
				{ "slug": "body-text", "name": "Text", "color": "#24344D" },
				{ "slug": "muted", "name": "Muted", "color": "#667085" },
				{ "slug": "brand", "name": "Brand blue", "color": "#1863DC" },
				{ "slug": "brand-dark", "name": "Brand blue dark", "color": "#104AA8" },
				{ "slug": "teal", "name": "Teal accent", "color": "#0F9F8F" },
				{ "slug": "light-blue", "name": "Light blue", "color": "#EAF2FF" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
				{ "slug": "soft-surface", "name": "Soft surface", "color": "#F6F8FB" },
				{ "slug": "border-color", "name": "Border", "color": "#D9E1EC" },
				{ "slug": "success", "name": "Success", "color": "#147D4D" },
				{ "slug": "error", "name": "Error", "color": "#B42318" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "Manrope, Inter, 'Segoe UI', Arial, sans-serif",
					"slug": "body",
					"name": "Manrope",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/manrope/manrope.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "clamp(1.125rem, 1.5vw, 1.375rem)", "fluid": false },
				{ "slug": "x-large", "name": "Heading 3", "size": "clamp(1.25rem, 2vw, 1.75rem)" },
				{ "slug": "xx-large", "name": "Heading 2", "size": "clamp(2rem, 3.5vw, 3.25rem)" },
				{ "slug": "display", "name": "Display", "size": "clamp(2.5rem, 5vw, 4.5rem)" }
			]
		},
		"spacing": {
			"units": ["px", "rem", "%", "vw"],
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "1rem" },
				{ "slug": "40", "name": "2", "size": "2rem" },
				{ "slug": "60", "name": "3", "size": "4rem" },
				{ "slug": "70", "name": "4", "size": "6rem" },
				{ "slug": "80", "name": "5", "size": "clamp(4rem, 9vw, 9rem)" }
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"color": {
			"background": "var(--wp--preset--color--surface)",
			"text": "var(--wp--preset--color--body-text)"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--20)",
				"right": "var(--wp--preset--spacing--20)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.15",
					"color": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1.08"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.12"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.25"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--brand)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--brand-dark)" }
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brand)",
					"text": "#FFFFFF"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "1rem",
					"fontWeight": "600",
					"textDecoration": "none"
				},
				"border": { "radius": "12px" },
				"spacing": { "padding": { "top": "0.875rem", "bottom": "0.875rem", "left": "1.5rem", "right": "1.5rem" } },
				":hover": {
					"color": { "background": "var(--wp--preset--color--brand-dark)", "text": "#FFFFFF" }
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--ink)", "style": "solid", "width": "2px", "offset": "2px" }
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-plain",
			"title": "Page, plain (no title)",
			"postTypes": ["page"]
		}
	]
}
